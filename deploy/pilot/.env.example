# Public DNS name, or the notebook's LAN IP for a first trial.
# With a LAN IP, trust Caddy's root certificate on staff devices; Google sign-in is unavailable.
PILOT_DOMAIN=192.168.1.41

# Use random URL-safe values; do not reuse development passwords.
LOCAL_DB_PASSWORD=
CLOUD_DB_PASSWORD=
CLUB_SOURCE_ID=
CLUB_SERVICE_TOKEN=

# Optional for LAN trial. For public access, authorize https://PILOT_DOMAIN in Google.
GOOGLE_CLIENT_ID=

# Habilita un único socio de prueba sin Google. Compartir el código solo con testers.
PILOT_MEMBER_LOGIN_ENABLED=true
PILOT_MEMBER_ACCESS_CODE=
